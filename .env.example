# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL with PostGIS extension required)
DATABASE_URL=postgresql+psycopg://electrimap:electrimap_password@localhost:5432/electrimap
TEST_DATABASE_URL=postgresql+psycopg://electrimap:electrimap_password@localhost:5432/electrimap_test

# Auth & Session Security (Generate a secure random string for production)
SESSION_SECRET=replace_this_with_a_secure_random_64_byte_hex_or_string_in_production
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_DAYS=7

# File Storage & Limits
DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_AOI_KM2=500
MAX_JOBS_PER_USER=2

# Execution & External API Modes
OFFLINE_MODE=false
HTTP_USER_AGENT=ElectriMapDPR/0.1 (academic-research; contact@electrimap.local)

# Keyless Open Services / Endpoints
OVERPASS_URL=https://overpass-api.de/api/interpreter
NASA_POWER_URL=https://power.larc.nasa.gov/api

# Open Data Storage Buckets (Direct No-Sign Public S3 / GCS)
DEM_COG_BASE=s3://copernicus-dem-30m/
WORLDCOVER_COG_BASE=s3://esa-worldcover/
NIGHTLIGHTS_SOURCE=HREA_IND

# Frontend Configuration
VITE_API_BASE=/api/v1
VITE_BASEMAP_VECTOR_STYLE=https://tiles.openfreemap.org/styles/liberty
# Default satellite: EOX Sentinel-2 cloudless 2016 (CC BY 4.0)
VITE_BASEMAP_SATELLITE_URL=https://tiles.maps.eox.at/wms?service=wms&request=GetMap&version=1.1.1&layers=s2cloudless-2016&styles=&format=image/jpeg&srs=EPSG:3857&width=256&height=256

